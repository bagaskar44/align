# Copy outside the checkout (for example /etc/align/private/compose.env), chmod 0600,
# replace every placeholder, and invoke Docker Compose with --env-file.
APP_ENV=production
APP_DEBUG=false
APP_DEMO_MODE=true
PROVIDER_MODE=mock
DATA_MODE=synthetic
ALIGN_PRODUCTION_OPENAI_API_KEY=
APP_ORIGIN=https://align.example.edu
APP_HOST=align.example.edu
ALIGN_CADDYFILE=./docker/Caddyfile.production
ALIGN_HOST_PORT=3000
S3_BUCKET=align-private-production
REDIS_QUEUE_PREFIX=align-production
POSTGRES_DB=align
OPERATOR_DB_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE

ALIGN_POSTGRES_ENV_FILE=/etc/align/private/postgres.env
ALIGN_MIGRATION_ENV_FILE=/etc/align/private/migration.env
ALIGN_API_ENV_FILE=/etc/align/private/api.env
ALIGN_OPERATOR_ENV_FILE=/etc/align/private/operator.env
ALIGN_WORKER_ENV_FILE=/etc/align/private/worker.env
ALIGN_PARSER_WORKER_ENV_FILE=/etc/align/private/parser.env
ALIGN_DISPATCHER_ENV_FILE=/etc/align/private/dispatcher.env
ALIGN_SCHEDULER_ENV_FILE=/etc/align/private/scheduler.env

# Use immutable registry references whose digest was verified and recorded.
ALIGN_POSTGRES_IMAGE=pgvector/pgvector:pg17@sha256:REPLACE_WITH_VERIFIED_DIGEST
ALIGN_REDIS_IMAGE=redis:7-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST
ALIGN_SEAWEEDFS_IMAGE=chrislusf/seaweedfs:REPLACE_WITH_TESTED_VERSION@sha256:REPLACE_WITH_VERIFIED_DIGEST
ALIGN_API_IMAGE=registry.example.edu/align-api:RELEASE@sha256:REPLACE_WITH_VERIFIED_DIGEST
ALIGN_WORKER_IMAGE=registry.example.edu/align-worker:RELEASE@sha256:REPLACE_WITH_VERIFIED_DIGEST
ALIGN_WEB_IMAGE=registry.example.edu/align-web:RELEASE@sha256:REPLACE_WITH_VERIFIED_DIGEST
ALIGN_CADDY_IMAGE=caddy:2.10.2-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST

ALIGN_SEAWEEDFS_S3_CONFIG_FILE=/etc/align/private/seaweedfs-s3.json
ALIGN_SEAWEEDFS_TLS_CERT_FILE=/etc/align/private/storage.crt
ALIGN_SEAWEEDFS_TLS_KEY_FILE=/etc/align/private/storage.key
ALIGN_SEAWEEDFS_CA_CERT_FILE=/etc/align/private/storage-ca.crt
