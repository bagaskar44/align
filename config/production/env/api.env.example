APP_ENV=production
APP_ORIGIN=https://align.example.edu
APP_DEBUG=false
APP_DEMO_MODE=true
PROVIDER_MODE=mock
PAID_CALLS_ENABLED=false
DATA_MODE=synthetic
DATABASE_URL=postgresql+psycopg://align_api:URL_ENCODED_SECRET@postgres:5432/align
OPERATOR_DATABASE_URL=postgresql+psycopg://align_operator:URL_ENCODED_SECRET@postgres:5432/align
WORKER_DATABASE_URL=postgresql+psycopg://align_worker:URL_ENCODED_SECRET@postgres:5432/align
MIGRATION_DATABASE_URL=postgresql+psycopg://align_migration:URL_ENCODED_SECRET@postgres:5432/align
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_PREFIX=align-production
S3_ENDPOINT=https://object-storage:8334
S3_BUCKET=align-private-production
S3_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_APPLICATION_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_APPLICATION_SECRET
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
CSRF_SERVER_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
MODEL_RATE_MANIFEST=config/model-rates.unverified.json
ROUTING_POLICY_FILE=config/routing.baseline.json
BATCHING_POLICY_FILE=config/batching.baseline.json
ALIGN_SEED_PASSWORD=
OPENAI_API_KEY=
