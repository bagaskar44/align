APP_ENV=production
APP_ORIGIN=https://align.example.edu
APP_DEMO_MODE=true
PROVIDER_MODE=mock
DATA_MODE=synthetic
DATABASE_URL=postgresql+psycopg://align_api:URL_ENCODED_SECRET@postgres:5432/align
OPERATOR_DATABASE_URL=postgresql+psycopg://align_operator:URL_ENCODED_SECRET@postgres:5432/align
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=https://object-storage:8334
S3_BUCKET=align-private-production
S3_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_OPERATOR_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_OPERATOR_SECRET
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
CSRF_SERVER_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
PARSER_NATIVE_MEMORY_BYTES=2147483648
PARSER_DOCUMENT_MEMORY_BYTES=8589934592
PARSER_NODE_MEMORY_BUDGET_BYTES=8589934592
PARSER_HEAVY_MAX_PER_NODE=1
PARSER_PAGE_BATCH_SIZE=1
ALIGN_SEED_PASSWORD=
OPENAI_API_KEY=
