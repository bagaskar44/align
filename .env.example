# Development template only. On macOS, run `bash scripts/dev-macos.sh bootstrap` to create private env files.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
APP_DEBUG=false
APP_DEMO_MODE=true
APP_LOG_LEVEL=INFO

POSTGRES_DB=align
POSTGRES_USER=align_root
POSTGRES_PASSWORD=replace-with-random-secret
MIGRATION_DB_PASSWORD=replace-with-random-secret
API_DB_PASSWORD=replace-with-random-secret
WORKER_DB_PASSWORD=replace-with-random-secret
OPERATOR_DB_PASSWORD=replace-with-random-secret
DATABASE_URL=postgresql+psycopg://align_api:replace-with-random-secret@postgres:5432/align
WORKER_DATABASE_URL=postgresql+psycopg://align_worker:replace-with-random-secret@postgres:5432/align
MIGRATION_DATABASE_URL=postgresql+psycopg://align_migration:replace-with-random-secret@postgres:5432/align
OPERATOR_DATABASE_URL=postgresql+psycopg://align_operator:replace-with-random-secret@postgres:5432/align
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_PREFIX=align-dev

S3_ENDPOINT=http://object-storage:9090
S3_BUCKET=align-private
S3_ACCESS_KEY_ID=align-app
S3_SECRET_ACCESS_KEY=replace-with-random-secret
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

CSRF_SERVER_SECRET=replace-with-at-least-32-random-bytes
PROVIDER_MODE=mock
PAID_CALLS_ENABLED=false
OPENAI_API_KEY=
MODEL_EFFICIENT=
MODEL_COMPLEX=
MODEL_VISION=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
MODEL_RATE_MANIFEST=config/model-rates.unverified.json
ROUTING_POLICY_FILE=config/routing.baseline.json
BATCHING_POLICY_FILE=config/batching.baseline.json
OCR_ENGINE=tesseract
OCR_LANGUAGE=ind+eng

DATA_MODE=synthetic
LMS_ADAPTER_ENABLED=false
ALIGN_SEED_PASSWORD=replace-with-random-development-password
BUDGET_CONFIRMED_USD=25.00
BUDGET_RESERVE_USD=5.00
BUDGET_PLANNED_TOPUP_USD=0.00
RETENTION_SOURCE_DAYS=90
RETENTION_REVIEW_DAYS=365
BACKUP_RETENTION_DAYS=30

MAX_FILES_PER_BUNDLE=5
MAX_FILE_BYTES=20971520
MAX_IMAGE_PIXELS=25000000
MAX_PDF_IMAGE_PAGES_PER_BUNDLE=100
MAX_XLSX_SHEETS=25
MAX_XLSX_NONEMPTY_CELLS=100000
MAX_DOCX_NODES=20000
MAX_DOCX_MEDIA=1000
MAX_OOXML_ENTRIES=10000
MAX_OOXML_EXPANDED_BYTES=536870912
JOB_MAX_CALLS=16
JOB_MAX_VISION_CALLS=4
JOB_MAX_TEXT_INPUT_TOKENS=40000
JOB_MAX_TEXT_OUTPUT_TOKENS=8000
JOB_MAX_EMBEDDING_TOKENS=80000
JOB_MAX_ACTIVE_SECONDS=600
ANALYSIS_BUDGET_USD=0.20
FEEDBACK_BUDGET_USD=0.03
CONTEXT_DRAFT_BUDGET_USD=0.05
SPEC_DRAFT_BUDGET_USD=0.05

PARSER_PROFILE_NATIVE=native_ooxml_v1
PARSER_PROFILE_DOCUMENT=docling_native_v1
PARSER_NATIVE_MEMORY_BYTES=2147483648
# Production profile; the development Compose stack explicitly overrides it to 4 GiB.
PARSER_DOCUMENT_MEMORY_BYTES=8589934592
# Local Compose development defaults to 4 GiB; this override can tune it.
ALIGN_DEV_PARSER_DOCUMENT_MEMORY_BYTES=4294967296
PARSER_LIGHT_MEMORY_BYTES=4294967296
PARSER_NODE_MEMORY_BUDGET_BYTES=8589934592
PARSER_NODE_HEADROOM_BYTES=1073741824
PARSER_NODE_ID=align-dev-node
PARSER_HEAVY_MAX_PER_NODE=1
PARSER_PAGE_BATCH_SIZE=1
PARSER_TASK_SOFT_SECONDS=120
PARSER_TASK_HARD_SECONDS=150
PARSER_MAX_ATTEMPTS=3
STAGE_SOFT_SECONDS=120
STAGE_HARD_SECONDS=150
BROKER_VISIBILITY_SECONDS=300
WORKER_LEASE_SECONDS=180
WORKER_HEARTBEAT_SECONDS=30
REAPER_INTERVAL_SECONDS=60
BATCH_BASELINE_ELEMENTS=1
BATCH_MAX_ELEMENTS=5

SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_HOURS=24
LOGIN_ACCOUNT_LIMIT=5
LOGIN_IP_LIMIT=20
LOGIN_WINDOW_SECONDS=900
MAX_PASSWORD_BYTES=512
